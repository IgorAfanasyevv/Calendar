rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(workspaceId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberUids;
    }

    // Профиль пользователя — читать/писать может только сам пользователь
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Пространство (workspace)
    match /workspaces/{workspaceId} {
      // Чтение открыто для любого авторизованного пользователя — это нужно,
      // чтобы можно было найти пространство по коду приглашения (inviteCode)
      // ДО того, как пользователь стал участником. Сам код приглашения — секрет,
      // который знают только два человека в паре, поэтому это приемлемый компромисс для MVP.
      allow read: if isSignedIn();

      // Создать пространство может любой авторизованный пользователь,
      // но только с самим собой в качестве владельца и единственного участника.
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.memberUids.hasOnly([request.auth.uid]);

      // Обновлять пространство может:
      // 1) пользователь, присоединяющийся по коду (добавляет самого себя в memberUids);
      // 2) владелец пространства — может менять что угодно, включая удаление участников;
      // 3) любой участник — но не список участников/владельца (совместные настройки:
      //    название, бюджет, валюта и т.п.).
      allow update: if
        (isSignedIn() && request.auth.uid in request.resource.data.memberUids && !(request.auth.uid in resource.data.memberUids)) ||
        (isSignedIn() && request.auth.uid == resource.data.ownerUid) ||
        (isMember(workspaceId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['members', 'memberUids', 'ownerUid']));

      // Удалить пространство может только владелец
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // Задачи, цели, покупки, presence — доступны только участникам пространства
      match /tasks/{taskId} {
        allow read, write: if isMember(workspaceId);
      }
      match /goals/{goalId} {
        allow read, write: if isMember(workspaceId);
      }
      match /shopping/{itemId} {
        allow read, write: if isMember(workspaceId);
      }
      match /finance/{entryId} {
        allow read, write: if isMember(workspaceId);
      }
      match /financeBoards/{boardId} {
        allow read, write: if isMember(workspaceId);
        match /entries/{entryId} {
          allow read, write: if isMember(workspaceId);
        }
      }
      match /activity/{entryId} {
        allow read, write: if isMember(workspaceId);
      }
      match /food/{entryId} {
        allow read, write: if isMember(workspaceId);
      }
      match /foodPresets/{presetId} {
        allow read, write: if isMember(workspaceId);
      }
      match /workouts/{entryId} {
        allow read, write: if isMember(workspaceId);
      }
      match /importantDates/{dateId} {
        allow read, write: if isMember(workspaceId);
      }
      match /habits/{habitId} {
        allow read, write: if isMember(workspaceId);
      }
      match /habitLogs/{logId} {
        allow read, write: if isMember(workspaceId);
      }
      match /journal/{entryId} {
        allow read, write: if isMember(workspaceId);
      }
      match /presence/{uid} {
        allow read: if isMember(workspaceId);
        allow write: if isMember(workspaceId) && request.auth.uid == uid;
      }
    }
  }
}
