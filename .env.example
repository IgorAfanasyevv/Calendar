# Скопируйте этот файл в .env и вставьте значения из вашего проекта Firebase
# Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Поиск по базе данных питания (USDA FoodData Central) — для дневника питания.
# Работает и без ключа (используется общий DEMO_KEY), но с низким лимитом запросов.
# Бесплатный личный ключ (мгновенно): https://fdc.nal.usda.gov/api-key-signup.html
VITE_USDA_API_KEY=DEMO_KEY
